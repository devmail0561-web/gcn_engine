      "source": "fn process_market(market: &mut Market) -> Result<Report, Error> {\n    let status = market.evaluate();\n    match status {\n        Status::Declining => {\n            market.reduce_costs(0.1);\n            Ok(Report::adjusted())\n        }\n        Status::Stable => Ok(Report::unchanged()),\n    }\n}\n",
